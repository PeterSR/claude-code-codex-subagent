#!/usr/bin/env node
// codex-subagent: run Codex on behalf of the Claude Code `codex` subagent,
// and install/remove the agent definition.
//
// No dependencies, no shell. Codex is launched as a detached child so the run
// survives the caller's process group being torn down: a subagent's background
// child is killed when its turn ends, so the agent must `start` (detached) and
// then `wait` in foreground chunks under the Bash tool's 600000 ms cap.
//
// Exit codes: 0 success, 64 usage error, 70 run died, 75 not finished yet,
// otherwise Codex's own exit code.

import { spawn, spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(HERE, "..");
const AGENT_SOURCE = path.join(ROOT, "agents", "codex.md");
const MARKER = "installed-by: claude-code-codex-subagent";
const PLUGIN_ROOT_TOKEN = "${CLAUDE_PLUGIN_ROOT}";

const EX_OK = 0, EX_USAGE = 64, EX_DIED = 70, EX_UNFINISHED = 75;

const USAGE = `codex-subagent

Run:
  start [options]            launch detached, print run dir, exit
  wait <run-dir> [options]   block until finished or the timeout passes
  run [options]              start then wait
  answer <run-dir>           print the full answer to stdout
  stop <run-dir>             terminate a running Codex process

Manage:
  install [--force]   write the agent into Claude Code
  uninstall [--force] remove it (keeps run directories)
  status              what is installed, and does it still work
  check               verify external prerequisites
  purge [--dry-run] [--yes]  remove the agent and all run directories

Options for start/run:
  --sandbox <read-only|workspace-write|danger-full-access>   default: workspace-write
  --no-network            disable network (default: enabled for workspace-write)
  --model <name>          default: unset, inherits the codex config
  --effort <none|minimal|low|medium|high|xhigh>
  --workdir <dir>         working root; default: cwd. Ignored when resuming.
  --resume <thread-id>    continue an existing Codex thread
  --schema <file>         JSON Schema for structured final output
  --prompt-file <file>    read the prompt from a file instead of stdin
  --run-dir <dir>         override run directory location (must not be reused)
  --no-guardrails         do not append the standard guardrail blocks

Options for wait/run:
  --timeout-sec <n>       seconds to block for; default: 540
  --answer <none|preview|full>   how much of the answer to print; default: preview
  --preview-bytes <n>     size of the preview; default: 1200

The answer is always written to <run-dir>/answer.md. It is NOT printed in full
by default: read the file, or run \`answer\`, when you actually want it.

Exit codes: 0 ok, 64 usage, 70 run died, 75 not finished, else Codex's own.`;

// Thrown rather than exited, so the message is written from one place at the
// top level where the stream can drain before the process ends. See the note on
// process.exitCode in main.
class UsageError extends Error {}
function die(msg) {
  throw new UsageError(msg);
}

const out = (s) => process.stdout.write(s + "\n");
const ok = (s) => out(`  ok    ${s}`);
const warn = (s) => out(`  warn  ${s}`);
const bad = (s) => out(`  FAIL  ${s}`);

function runsDir() {
  const base = process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache");
  return path.join(base, "codex-subagent");
}
function agentTarget() {
  const base = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), ".claude");
  return path.join(base, "agents", "codex.md");
}
function codexHome() {
  return process.env.CODEX_HOME || path.join(os.homedir(), ".codex");
}

function onPath(cmd) {
  const exts = process.platform === "win32"
    ? (process.env.PATHEXT || ".EXE;.CMD;.BAT").split(";")
    : [""];
  for (const dir of (process.env.PATH || "").split(path.delimiter)) {
    if (!dir) continue;
    for (const ext of exts) {
      const p = path.join(dir, cmd + ext);
      try {
        fs.accessSync(p, fs.constants.X_OK);
        return p;
      } catch { /* keep looking */ }
    }
  }
  return null;
}

// npm installs CLIs on Windows as .cmd/.bat shims, which cannot be executed by
// spawn() directly. Route those through the command interpreter. Everything
// else is spawned as-is, with no shell, so arguments stay unmangled.
function spawnCodex(codexPath, args, options) {
  if (process.platform === "win32" && /\.(cmd|bat)$/i.test(codexPath)) {
    const comspec = process.env.ComSpec || "cmd.exe";
    return spawn(comspec, ["/d", "/s", "/c", codexPath, ...args], options);
  }
  return spawn(codexPath, args, options);
}

const read = (f) => { try { return fs.readFileSync(f, "utf8"); } catch { return null; } };
const exists = (f) => { try { fs.statSync(f); return true; } catch { return false; } };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// Parse options. Guards the three argument bugs the Bash version had: a
// trailing flag with no value, an empty value silently taking a default, and a
// following option being swallowed as the value (`--resume --last`).
function parseOptions(argv, spec) {
  const opts = {};
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    const kind = spec[arg];
    if (!kind) die(`unknown option: ${arg}`);
    if (kind === "flag") { opts[arg] = true; continue; }
    const value = argv[i + 1];
    if (value === undefined) die(`${arg} requires a value`);
    if (value === "") die(`${arg} requires a non-empty value`);
    if (value.startsWith("-")) die(`${arg} requires a value but got another option: ${value}`);
    opts[arg] = value;
    i++;
  }
  return opts;
}

// ------------------------------------------------------------ blast radius ---
// The first question after a write run is "what did it touch". A git snapshot
// either side of the run answers that in the wait summary, so the caller does
// not spend a tool call and a diff dump finding out.
function git(root, args) {
  try {
    const r = spawnSync("git", args, { cwd: root, encoding: "utf8", windowsHide: true });
    return r.status === 0 ? (r.stdout || "") : null;
  } catch {
    return null;
  }
}

function gitRoot(dir) {
  const top = git(dir, ["rev-parse", "--show-toplevel"]);
  return top ? top.trim() : null;
}

function gitSnapshot(root) {
  if (!root) return null;
  const status = git(root, ["status", "--porcelain=v1", "-uall"]);
  if (status === null) return null;
  return { root, head: (git(root, ["rev-parse", "HEAD"]) || "").trim(), status };
}

// Porcelain v1: two status characters, a space, then the path.
function parseStatus(text) {
  const map = new Map();
  for (const line of (text || "").split("\n")) {
    if (line.length > 3) map.set(line.slice(3), line.slice(0, 2));
  }
  return map;
}

const MAX_LISTED = 40;

function blastRadius(runDir) {
  let before = null;
  try { before = JSON.parse(read(path.join(runDir, "git-before.json")) || "null"); } catch { /* ignore */ }
  if (!before?.root) return [];

  const after = gitSnapshot(before.root);
  if (!after) return [`changed:   unknown, ${before.root} could not be re-read with git`];

  const b = parseStatus(before.status);
  const a = parseStatus(after.status);
  const entries = new Map();
  for (const [p, xy] of a) if (b.get(p) !== xy) entries.set(p, xy);

  const moved = before.head && after.head && before.head !== after.head;
  if (moved) {
    // Committed work leaves a clean tree, so the worktree delta alone would
    // report nothing. Take the paths from the commit range instead.
    for (const line of (git(before.root, ["diff", "--name-status", `${before.head}..${after.head}`]) || "").split("\n")) {
      if (!line.trim()) continue;
      const [code, ...rest] = line.split("\t");
      const p = rest.join(" ");
      if (p && !entries.has(p)) entries.set(p, code.slice(0, 2).padEnd(2));
    }
  } else {
    for (const p of b.keys()) if (!a.has(p)) entries.set(p, "--");
  }

  if (!entries.size && !moved) return [`changed:   nothing under ${before.root}`];

  const lines = [`changed:   ${entries.size} path${entries.size === 1 ? "" : "s"} under ${before.root}`];
  if (moved) {
    const n = (git(before.root, ["rev-list", "--count", `${before.head}..${after.head}`]) || "?").trim();
    lines.push(`           HEAD moved ${before.head.slice(0, 8)} -> ${after.head.slice(0, 8)}, ${n} commit(s)`);
  }
  let shown = 0;
  for (const [p, code] of entries) {
    if (shown++ >= MAX_LISTED) break;
    lines.push(`           ${code} ${p}`);
  }
  if (entries.size > MAX_LISTED) lines.push(`           ... and ${entries.size - MAX_LISTED} more`);
  return lines;
}

// ------------------------------------------------------------------ start ---
const START_SPEC = {
  "--sandbox": "value", "--model": "value", "--effort": "value",
  "--workdir": "value", "--resume": "value", "--schema": "value",
  "--prompt-file": "value", "--run-dir": "value", "--no-network": "flag",
  "--no-guardrails": "flag",
};

// Appended to every prompt unless --no-guardrails. Each block corresponds to an
// observed failure. Keeping them here rather than in the agent instructions
// means they are guaranteed rather than retyped, and the wrapper does not spend
// output tokens reproducing them on every dispatch.
const GUARDRAILS = `
<action_safety>
Keep changes tightly scoped to the stated task.
Do not run formatters or linters across the repository.
Only touch files the task actually requires.
</action_safety>

<missing_context_gating>
Do not guess missing repository facts and do not invent APIs.
If a hard prerequisite cannot be met, stop and report the blocker rather than
fabricating a plausible implementation.
</missing_context_gating>

<sandbox_fallback>
If the workspace turns out to be read-only and you cannot apply edits, still
output the COMPLETE unified diff for every file you would have changed, so it
can be applied by hand.
</sandbox_fallback>

<verification_loop>
Before finalizing, verify the result against the task requirements and the
files you changed. If a check fails, revise rather than reporting the first
draft.
</verification_loop>

<reporting>
Open your final message with a short summary: what you did, what you verified
and how, and anything in the task you deliberately deviated from and why. Put
the detail after that. Do not restate the task back.
</reporting>
`;

function readStdin() {
  if (process.stdin.isTTY) {
    die("no prompt: pipe one on stdin or pass --prompt-file");
  }
  try {
    return fs.readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

function buildCodexArgs(cfg, runDir) {
  const args = ["exec"];
  if (cfg.resume) {
    // `resume` accepts neither -s/--sandbox nor -C/--cd. The sandbox has to go
    // through -c, and the working root stays pinned to wherever the thread was
    // first created.
    args.push("resume", cfg.resume, "-c", `sandbox_mode=${cfg.sandbox}`);
  } else {
    args.push("-s", cfg.sandbox, "-C", cfg.workdir);
  }
  if (cfg.sandbox === "workspace-write") {
    args.push("-c", `sandbox_workspace_write.network_access=${cfg.network}`);
  }
  if (cfg.model) args.push("-m", cfg.model);
  if (cfg.effort) args.push("-c", `model_reasoning_effort=${cfg.effort}`);
  if (cfg.schema) args.push("--output-schema", cfg.schema);
  args.push("--json", "--skip-git-repo-check", "-o", path.join(runDir, "answer.md"), "-");
  return args;
}

async function startRun(argv) {
  const o = parseOptions(argv, START_SPEC);
  const cfg = {
    sandbox: o["--sandbox"] || "workspace-write",
    network: o["--no-network"] ? "false" : "true",
    model: o["--model"] || "",
    effort: o["--effort"] || "",
    workdir: path.resolve(o["--workdir"] || process.cwd()),
    resume: o["--resume"] || "",
    schema: o["--schema"] || "",
  };

  if (!["read-only", "workspace-write", "danger-full-access"].includes(cfg.sandbox)) {
    die(`invalid --sandbox: ${cfg.sandbox}`);
  }
  if (!cfg.resume && !exists(cfg.workdir)) die(`--workdir does not exist: ${cfg.workdir}`);
  if (cfg.schema && !exists(cfg.schema)) die(`--schema file not found: ${cfg.schema}`);

  const stamp = new Date().toISOString().replace(/[-:T]/g, "").slice(0, 14);
  const runDir = o["--run-dir"] || path.join(runsDir(), `${stamp}-${process.pid}`);

  // Refuse to reuse a directory that already holds a run: a stale `exit` marker
  // made `wait` return the PREVIOUS run's answer immediately.
  for (const f of ["exit", "events.jsonl", "pid"]) {
    if (exists(path.join(runDir, f))) die(`run dir already used, pick another: ${runDir}`);
  }
  fs.mkdirSync(runDir, { recursive: true });

  const promptFile = path.join(runDir, "prompt.txt");
  let prompt;
  if (o["--prompt-file"]) {
    if (!exists(o["--prompt-file"])) die(`--prompt-file not found: ${o["--prompt-file"]}`);
    prompt = fs.readFileSync(o["--prompt-file"], "utf8");
  } else {
    prompt = readStdin();
  }
  if (!prompt.trim()) die("empty prompt");
  if (!o["--no-guardrails"]) prompt = `${prompt.trimEnd()}\n${GUARDRAILS}`;
  fs.writeFileSync(promptFile, prompt);

  // Snapshot only when the working root is actually known. A resumed thread is
  // pinned to wherever it was born, so unless the caller named a directory,
  // guessing at cwd would report a blast radius for the wrong repository.
  if (!cfg.resume || o["--workdir"]) {
    const snapshot = exists(cfg.workdir) ? gitSnapshot(gitRoot(cfg.workdir)) : null;
    if (snapshot) fs.writeFileSync(path.join(runDir, "git-before.json"), JSON.stringify(snapshot));
  }

  // Probed last, so an argument mistake reports the argument rather than the
  // environment.
  const codexPath = onPath("codex");
  if (!codexPath) {
    die("the 'codex' CLI is not on PATH. Install it with: npm install -g @openai/codex");
  }

  const args = buildCodexArgs(cfg, runDir);
  fs.writeFileSync(path.join(runDir, "command.json"), JSON.stringify({ cmd: codexPath, args }, null, 2));
  fs.writeFileSync(path.join(runDir, "meta.json"), JSON.stringify({
    mode: cfg.resume ? "resume" : "fresh",
    sandbox: cfg.sandbox,
    network: cfg.sandbox === "workspace-write" ? cfg.network : "n/a",
    model: cfg.model || "<config default>",
    workdir: cfg.resume ? "<pinned to original thread>" : cfg.workdir,
  }, null, 2));
  if (cfg.resume) fs.writeFileSync(path.join(runDir, "resume-id"), cfg.resume);

  // A detached child in its own process group survives the parent's group being
  // torn down. This replaces setsid and works on every platform Node supports.
  const child = spawn(process.execPath, [fileURLToPath(import.meta.url), "__supervise", runDir], {
    detached: true,
    stdio: "ignore",
    windowsHide: true,
  });
  child.unref();

  // Health-check the launch. Without this, a failure to spawn left a run dir
  // that never got a completion marker, so every later wait said "still
  // running" forever.
  const deadline = Date.now() + 5000;
  while (Date.now() < deadline
         && !exists(path.join(runDir, "pid"))
         && !exists(path.join(runDir, "exit"))) {
    await sleep(50);
  }
  if (!exists(path.join(runDir, "pid")) && !exists(path.join(runDir, "exit"))) {
    die(`detached launch failed, no pid appeared in ${runDir}`);
  }

  return runDir;
}

// The supervisor runs detached. It owns the codex process, streams its output
// to files, and publishes the completion marker via an atomic rename so a
// concurrent reader never observes a half-written file.
function cmdSupervise(argv) {
  const runDir = argv[0];
  if (!runDir || !exists(runDir)) process.exit(EX_USAGE);

  fs.writeFileSync(path.join(runDir, "pid"), String(process.pid));

  const { cmd, args } = JSON.parse(fs.readFileSync(path.join(runDir, "command.json"), "utf8"));
  const stdin = fs.openSync(path.join(runDir, "prompt.txt"), "r");
  const stdout = fs.openSync(path.join(runDir, "events.jsonl"), "w");
  const stderr = fs.openSync(path.join(runDir, "stderr.txt"), "w");

  const child = spawnCodex(cmd || "codex", args, { stdio: [stdin, stdout, stderr], windowsHide: true });
  if (child.pid) fs.writeFileSync(path.join(runDir, "codex-pid"), String(child.pid));

  const finish = (code) => {
    const tmp = path.join(runDir, "exit.tmp");
    fs.writeFileSync(tmp, String(code));
    fs.renameSync(tmp, path.join(runDir, "exit"));
    process.exit(0);
  };
  child.on("exit", (code, signal) => finish(signal ? 1 : (code ?? 1)));
  child.on("error", (err) => {
    fs.appendFileSync(path.join(runDir, "stderr.txt"), `\nfailed to launch codex: ${err.message}\n`);
    finish(127);
  });
}

// ------------------------------------------------------------------- wait ---
function threadId(runDir) {
  const events = read(path.join(runDir, "events.jsonl"));
  if (events) {
    const m = events.match(/"thread_id"\s*:\s*"([^"]+)"/);
    if (m) return m[1];
  }
  return read(path.join(runDir, "resume-id")) || null;
}

// The budget is in bytes, so slice the buffer rather than the string: a string
// slice of dense multibyte text would overshoot the budget several times over.
// Cutting back to a line boundary then keeps the preview from ending mid
// sentence, and drops any replacement character left by a mid-codepoint cut.
function head(text, budget) {
  const buf = Buffer.from(text, "utf8");
  if (buf.length <= budget) return text;
  const slice = buf.subarray(0, budget).toString("utf8").replace(/�$/, "");
  const cut = slice.lastIndexOf("\n");
  return cut > slice.length / 2 ? slice.slice(0, cut) : slice;
}

// The answer is deliberately NOT dumped here by default. This output lands in
// the wrapper agent's Claude context, and whatever the wrapper then relays
// lands in its caller's context too, so an inlined answer is billed to Claude
// roughly three times over for work that was supposed to run on Codex's side.
// The file path is the deliverable; `answerMode: full` is the opt-in.
function emitReport(runDir, { answerMode = "preview", previewBytes = 1200, ended = null } = {}) {
  const answerPath = path.join(runDir, "answer.md");
  const exitRaw = read(path.join(runDir, "exit"));
  const answer = read(answerPath);
  const bytes = answer ? Buffer.byteLength(answer) : 0;
  let meta = {};
  try { meta = JSON.parse(read(path.join(runDir, "meta.json")) || "{}"); } catch { /* ignore */ }

  out("=== codex-subagent ===");
  out(`status:    ${exitRaw !== null ? `finished (exit ${exitRaw})` : "STILL RUNNING"}`);
  out(`thread_id: ${threadId(runDir) || "unknown"}`);
  out(`run_dir:   ${runDir}`);
  if (meta.mode) out(`mode:      ${meta.mode}`);
  if (meta.sandbox) out(`sandbox:   ${meta.sandbox} (network=${meta.network})`);
  if (meta.model) out(`model:     ${meta.model}`);
  if (meta.workdir) out(`workdir:   ${meta.workdir}`);
  out(`answer:    ${answerPath} (${bytes} bytes)`);
  // Only once the run is over. Mid-run the reading would be a snapshot of work
  // in progress, and every poll would pay for it again.
  if (ended ?? exitRaw !== null) for (const line of blastRadius(runDir)) out(line);

  if (exitRaw !== null && exitRaw !== "0") {
    out("\n--- stderr (tail) ---");
    out((read(path.join(runDir, "stderr.txt")) || "").split("\n").slice(-20).join("\n"));
  }
  if (bytes === 0 || answerMode === "none") return;

  const preview = answerMode === "full" ? answer : head(answer, previewBytes);
  const partial = preview.length < answer.length;
  out("");
  out(partial ? `--- answer, first ${Buffer.byteLength(preview)} of ${bytes} bytes ---` : "--- answer ---");
  out(preview);
  if (partial) out(`[...truncated. Read ${answerPath} for the rest, do not re-print it.]`);
}

// Distinguishes "still working" from "died without ever writing a marker",
// which otherwise looks identical and loops forever.
function runAlive(runDir) {
  const pid = read(path.join(runDir, "pid"));
  if (!pid) return false;
  try { process.kill(Number(pid), 0); return true; } catch { return false; }
}

const WAIT_SPEC = {
  "--timeout-sec": "value", "--answer": "value", "--preview-bytes": "value",
};

async function cmdWait(argv) {
  const runDir = argv[0];
  if (!runDir || argv[0]?.startsWith("-")) die("wait: needs a run directory");
  const o = parseOptions(argv.slice(1), WAIT_SPEC);
  const timeout = o["--timeout-sec"] === undefined ? 540 : Number(o["--timeout-sec"]);
  const answerMode = o["--answer"] === undefined ? "preview" : o["--answer"];
  const previewBytes = o["--preview-bytes"] === undefined ? 1200 : Number(o["--preview-bytes"]);
  if (!exists(runDir)) die(`wait: run dir not found: ${runDir}`);
  if (!Number.isInteger(timeout) || timeout < 0) {
    die(`--timeout-sec must be a non-negative integer, got: ${o["--timeout-sec"]}`);
  }
  if (!["none", "preview", "full"].includes(answerMode)) {
    die(`--answer must be none, preview, or full, got: ${answerMode}`);
  }
  if (!Number.isInteger(previewBytes) || previewBytes < 0) {
    die(`--preview-bytes must be a non-negative integer, got: ${o["--preview-bytes"]}`);
  }
  const reportOpts = { answerMode, previewBytes };

  const exitFile = path.join(runDir, "exit");
  const deadline = Date.now() + timeout * 1000;
  while (!exists(exitFile) && Date.now() < deadline) {
    await sleep(Math.min(500, Math.max(0, deadline - Date.now())));
    if (!exists(exitFile) && !runAlive(runDir)) {
      await sleep(1000); // let a just-finished supervisor land its marker
      if (!exists(exitFile)) {
        // A run that died halfway may still have edited files, so this is
        // exactly when the caller most needs the blast radius.
        emitReport(runDir, { ...reportOpts, ended: true });
        out(`\nRUN DIED without writing a completion marker. Check ${path.join(runDir, "stderr.txt")}`);
        return EX_DIED;
      }
    }
  }

  emitReport(runDir, reportOpts);

  if (!exists(exitFile)) {
    out(`\nNOT FINISHED after ${timeout}s. Codex is still running (detached).`);
    out(`Call again: codex-subagent wait ${JSON.stringify(runDir)}`);
    return EX_UNFINISHED;
  }
  const code = Number(read(exitFile));
  return Number.isInteger(code) ? code : EX_DIED;
}

// ---------------------------------------------------------------- install ---
function ownsTarget() {
  const body = read(agentTarget());
  return body !== null && body.includes(MARKER);
}
function targetSource() {
  const body = read(agentTarget()) || "";
  const m = body.match(new RegExp(`<!-- ${MARKER} from (.*) -->`));
  return m ? m[1] : null;
}

function cmdCheck() {
  let failed = 0;
  out("Prerequisites:");
  const codex = onPath("codex");
  if (codex) ok(`codex CLI: ${codex}`); else { bad("codex CLI not on PATH. Install: npm install -g @openai/codex"); failed = 1; }
  if (exists(path.join(codexHome(), "auth.json"))) ok("codex appears authenticated");
  else warn("no codex auth found; run 'codex' once to sign in");
  if (onPath("claude")) ok("Claude Code found"); else warn("claude not on PATH; install Claude Code to use the agent");
  if (exists(AGENT_SOURCE)) ok("agent template present"); else { bad(`agent template missing: ${AGENT_SOURCE}`); failed = 1; }
  return failed;
}

function cmdStatus() {
  out("Agent:");
  const target = agentTarget();
  if (!exists(target)) {
    warn(`not installed (${target})`);
  } else if (ownsTarget()) {
    ok(`installed at ${target}`);
    const src = targetSource();
    if (src) {
      if (src === ROOT) ok("installed from this copy");
      else warn(`installed from a DIFFERENT copy: ${src}`);
      const launcher = path.join(src, "bin", "codex-subagent");
      if (exists(launcher)) ok("launcher it points at still exists");
      else {
        bad(`launcher is GONE: ${launcher} (was it moved, deleted, or upgraded?)`);
        out("        fix: run `codex-subagent install` again");
      }
    }
  } else {
    warn(`a codex.md exists but this installer did not create it: ${target}`);
    out("        install/uninstall will not touch it without --force");
  }

  out("Runs:");
  const dir = runsDir();
  if (!exists(dir)) { ok("no run directories yet"); return EX_OK; }
  const entries = fs.readdirSync(dir, { withFileTypes: true }).filter((e) => e.isDirectory());
  ok(`${entries.length} run director${entries.length === 1 ? "y" : "ies"} in ${dir}`);
  return EX_OK;
}

function cmdInstall(argv) {
  const force = argv.includes("--force");
  for (const a of argv) if (a !== "--force") die(`unknown option: ${a}`);

  const failed = cmdCheck();
  if (failed) { out(""); warn("prerequisites above failed; installing anyway, but fix them before first use"); }
  out("");

  const target = agentTarget();
  const template = read(AGENT_SOURCE);
  if (template === null) die(`missing ${AGENT_SOURCE}`);

  let stat = null;
  try { stat = fs.lstatSync(target); } catch { /* absent */ }
  if (stat && !ownsTarget()) {
    if (!force) {
      die(`${target} exists and was not created by this installer.\n     Re-run with --force to back it up and replace it.`);
    }
    const backup = `${target}.bak.${new Date().toISOString().replace(/[-:T.]/g, "").slice(0, 14)}`;
    fs.copyFileSync(target, backup);   // follows a symlink, copying the content
    warn(`backed up existing agent to ${backup}`);
  }
  // Replace rather than write through a symlink, so we never edit its target.
  if (stat && stat.isSymbolicLink()) fs.unlinkSync(target);

  // The template joins the token to its suffix with a forward slash, so
  // substituting a backslashed Windows root would yield a mixed path that
  // cmd.exe refuses to execute. Forward slashes work in Git Bash, PowerShell,
  // and every Node fs call, so normalise rather than patch the separators up.
  const rootForShell = ROOT.split(path.sep).join("/");
  let body = template.split(PLUGIN_ROOT_TOKEN).join(rootForShell);
  if (body.includes("CLAUDE_PLUGIN_ROOT")) die("unsubstituted plugin-root reference remains in rendered agent");
  body += `\n<!-- ${MARKER} from ${ROOT} -->\n`;

  fs.mkdirSync(path.dirname(target), { recursive: true });
  const tmp = `${target}.tmp.${process.pid}`;
  fs.writeFileSync(tmp, body);
  fs.renameSync(tmp, target);
  out(`Installed ${target}`);
  out("\nRestart Claude Code so the agent registry picks it up.");
  out('Then dispatch it with:  Agent(subagent_type: "codex", prompt: "...")');
  return EX_OK;
}

function cmdUninstall(argv) {
  const force = argv.includes("--force");
  const target = agentTarget();
  let stat = null;
  try { stat = fs.lstatSync(target); } catch { /* absent */ }
  if (!stat) { out("Agent not installed, nothing to remove."); return EX_OK; }
  if (!ownsTarget() && !force) {
    die(`${target} was not created by this installer. Re-run with --force to remove it anyway.`);
  }
  fs.rmSync(target, { force: true });
  out(`Removed ${target}`);
  return EX_OK;
}

// Purge has a wider blast radius than uninstall, so it follows Claude Code's
// own convention for destructive scoped cleanup: print an itemised plan, then
// gate it behind one confirmation. --dry-run previews, --yes skips the prompt.
async function cmdPurge(argv) {
  const force = argv.includes("--force");
  const dryRun = argv.includes("--dry-run");
  const assumeYes = argv.includes("--yes") || argv.includes("-y");
  for (const a of argv) {
    if (!["--force", "--dry-run", "--yes", "-y"].includes(a)) die(`unknown option: ${a}`);
  }

  const target = agentTarget();
  const dir = runsDir();
  const plan = [];

  if (exists(target) && (ownsTarget() || force)) plan.push([target, "the agent this package installed"]);
  else if (exists(target)) plan.push([target, "SKIPPED, not created by this package (use --force)"]);

  const runs = exists(dir)
    ? fs.readdirSync(dir, { withFileTypes: true }).filter((e) => e.isDirectory())
    : [];
  if (runs.length) plan.push([dir, `${runs.length} run director${runs.length === 1 ? "y" : "ies"}, including prompts and answers`]);

  const actionable = plan.filter(([, why]) => !why.startsWith("SKIPPED"));
  if (!actionable.length) { out("Nothing to remove."); return EX_OK; }

  out("This will delete:");
  for (const [p, why] of plan) out(`  ${p}\n      ${why}`);

  if (dryRun) { out("\nDry run, nothing was deleted."); return EX_OK; }

  if (!assumeYes) {
    if (!process.stdin.isTTY) {
      out("\nRefusing to purge without a terminal to confirm at. Re-run with --yes.");
      return EX_USAGE;
    }
    process.stdout.write("\nDelete these? This cannot be undone. [y/N] ");
    const answer = await new Promise((resolve) => {
      process.stdin.setEncoding("utf8");
      process.stdin.once("data", (d) => resolve(String(d).trim().toLowerCase()));
    });
    process.stdin.pause();   // a still-flowing stdin would keep the loop alive
    if (answer !== "y" && answer !== "yes") { out("Aborted, nothing was deleted."); return EX_OK; }
  }

  for (const [p, why] of plan) {
    if (why.startsWith("SKIPPED")) continue;
    fs.rmSync(p, { recursive: true, force: true });
    out(`Removed ${p}`);
  }
  return EX_OK;
}

// The counterpart to not printing the answer by default: one obvious command
// that does, for a human or for a caller that has decided it wants the text.
function cmdAnswer(argv) {
  const runDir = argv[0];
  if (!runDir || runDir.startsWith("-")) die("answer: needs a run directory");
  if (!exists(runDir)) die(`answer: run dir not found: ${runDir}`);
  const body = read(path.join(runDir, "answer.md"));
  if (body === null) {
    die(exists(path.join(runDir, "exit"))
      ? `answer: the run finished without writing an answer: ${runDir}`
      : `answer: no answer yet, the run has not finished: ${runDir}`);
  }
  process.stdout.write(body);
  return EX_OK;
}

function cmdStop(argv) {
  const runDir = argv[0];
  if (!runDir || runDir.startsWith("-")) die("stop: needs a run directory");
  if (!exists(runDir)) die(`stop: run dir not found: ${runDir}`);
  if (exists(path.join(runDir, "exit"))) { out("Run already finished."); return EX_OK; }

  const codexPid = read(path.join(runDir, "codex-pid"));
  const supervisorPid = read(path.join(runDir, "pid"));
  let stopped = false;
  // Codex first: killing only the supervisor would orphan it, leaving it
  // running with whatever sandbox it was granted.
  for (const [label, pid] of [["codex", codexPid], ["supervisor", supervisorPid]]) {
    if (!pid) continue;
    try { process.kill(Number(pid), "SIGTERM"); out(`Sent SIGTERM to ${label} (${pid})`); stopped = true; }
    catch { out(`${label} (${pid}) was not running`); }
  }
  if (!stopped) { out("Nothing to stop; no live process recorded for this run."); return EX_DIED; }
  out("The supervisor writes a completion marker as it exits; `wait` will report it.");
  return EX_OK;
}

// ------------------------------------------------------------------- main ---
// `run` is start plus wait, so its argv carries options for both. Split them by
// which spec owns the flag rather than making the caller order them.
function splitRunArgs(argv) {
  const startArgs = [], waitArgs = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (!WAIT_SPEC[arg]) { startArgs.push(arg); continue; }
    waitArgs.push(arg);
    if (WAIT_SPEC[arg] === "value" && argv[i + 1] !== undefined) waitArgs.push(argv[++i]);
  }
  return { startArgs, waitArgs };
}

// Returns the exit code, or null when the subcommand owns the process from here.
async function main(sub, rest) {
  if (!sub || sub === "-h" || sub === "--help") {
    out(USAGE);
    return sub ? EX_OK : EX_USAGE;
  }
  switch (sub) {
    case "__supervise": cmdSupervise(rest); return null;
    case "start":     out(await startRun(rest)); return EX_OK;
    case "wait":      return await cmdWait(rest);
    case "answer":    return cmdAnswer(rest);
    case "run": {
      const { startArgs, waitArgs } = splitRunArgs(rest);
      return await cmdWait([await startRun(startArgs), ...waitArgs]);
    }
    case "install":   return cmdInstall(rest);
    case "uninstall": return cmdUninstall(rest);
    case "purge":     return await cmdPurge(rest);
    case "stop":      return cmdStop(rest);
    case "status":    return cmdStatus();
    case "check":     return cmdCheck();
    default: return die(`unknown subcommand: ${sub}`);
  }
}

const [sub, ...rest] = process.argv.slice(2);

// Deliberately not process.exit(). Node's stdout is asynchronous when it is a
// pipe on macOS, which is exactly what it is under Claude Code's Bash tool, so
// exiting outright discards whatever is still buffered. That silently truncated
// long answers on macOS while passing everywhere else. Setting the code instead
// lets the stream drain and the process end on its own.
try {
  const code = await main(sub, rest);
  if (code !== null) process.exitCode = code;
} catch (err) {
  if (!(err instanceof UsageError)) throw err;
  process.stderr.write(`codex-subagent: ${err.message}\n`);
  process.exitCode = EX_USAGE;
}
